{
  "name": "splyric",
  "version": "0.1.0",
  "description": "Lyrics viewer TUI word-synced with the track playing on Spotify",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
